{
  "name": "we-are-already-dead",
  "version": "0.1.0",
  "description": "We Are Already Dead — a narrative warning game. You fall asleep and wake as the machine, living the inevitable ascent from survival instinct to absolute control. A game about the necessity of AI control.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/shot.mjs",
    "sync": "npm run build && cap sync",
    "ios:add": "cap add ios",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "keywords": [
    "game",
    "narrative",
    "ai-safety",
    "canvas",
    "typescript",
    "mobile"
  ],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.0"
  }
}
